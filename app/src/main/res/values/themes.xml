<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompatActivity requires an AppCompat theme; Compose handles visual styling. -->
    <style name="Theme.BrickBlast" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="Theme.BrickBlast.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.BrickBlast</item>
    </style>
</resources>
